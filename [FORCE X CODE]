function updateBeam(dt,firing){
  const P=player, g=curGun();
  if(g.mode!=='beam'){if(P.beamOn){P.beamOn=false;} beamCore.visible=beamGlow.visible=false; return;}
  const hasAmmo=P.midasT>0||P.ammo[P.slot]>0;
  P.beamCool-=dt; if(!firing)P.beamNeedRelease=false;
  if(!P.beamOn&&firing&&hasAmmo&&P.swapT<=0&&P.beamCool<=0&&!P.beamNeedRelease){P.beamOn=true; toast('⚡ The Guardian is awake. It won\u2019t stop until the tank runs dry.'); sfx('ability');}
  if(P.beamOn&&!hasAmmo){P.beamOn=false; P.beamCool=1.5; P.beamNeedRelease=true; sfx('pop'); toast('The Guardian ran dry and let go. Refill at the tank.');}
  if(!P.beamOn){beamCore.visible=beamGlow.visible=false; return;}
  if(P.midasT<=0)P.ammo[P.slot]=Math.max(0,P.ammo[P.slot]-g.water*dt);
  const F=shotFrame(g.mz,0);
  let dx=F.top?F.dx:F.dx, dy=F.top?-0.02:F.dy, dz=F.dz; const l=Math.hypot(dx,dy,dz)||1; dx/=l; dy/=l; dz/=l;
  let len=g.range;
  if(dy<-0.001)len=Math.min(len,-(F.y-0.05)/dy);
  for(let t=0.5;t<len;t+=0.4){const x=F.x+dx*t,y=F.y+dy*t,z=F.z+dz*t; if(y>2.2)continue; let hitC=false; for(const c of colliders)if((x-c.x)**2+(z-c.z)**2<c.r*c.r){hitC=true;break;} if(hitC){len=t;break;}}
  for(const e of enemies){
    if(e.dead)continue; const gy=e.g.position.y;
    const t=(e.x-F.x)*dx+(gy+e.h*0.5-F.y)*dy+(e.z-F.z)*dz; if(t<0||t>len+e.r)continue;
    const px=F.x+dx*t,py=F.y+dy*t,pz=F.z+dz*t;
    if(Math.hypot(px-e.x,pz-e.z)<e.r+0.25&&py>gy-0.3&&py<gy+e.h+0.4){
      damageEnemy(e,g.dps*dt,dx*0.6,dz*0.6,'ap'); hitMarker();
      if(Math.random()<0.5)burst(px,py,pz,2,Math.random()<0.5?0xecfeff:e.T.color,4,3,12,0.3);
    }
  }
  const ex=F.x+dx*len,ey=F.y+dy*len,ez=F.z+dz*len;
  if(Math.random()<0.6)burst(ex,Math.max(0.1,ey),ez,2,0x67e8f9,3,3,10,0.3);
  const mid=new THREE.Vector3((F.x+ex)/2,(F.y+ey)/2,(F.z+ez)/2), dir=new THREE.Vector3(dx,dy,dz);
  for(const [b,r] of [[beamCore,0.05+Math.random()*0.02],[beamGlow,0.16+Math.random()*0.05]]){
    b.visible=true; b.position.copy(mid); b.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),dir); b.scale.set(r,len,r);
  }
  sprayT-=dt; if(sprayT<=0){sfx('spray'); sprayT=0.05;}
  shake=Math.max(shake,0.04);
}
function updateGun(dt,firing){
  const P=player, id=curGunId(), g=GUNS[id];
  if(P.reloadT>0){P.reloadT-=dt; if(P.reloadT<=0){P.reloadT=0; P.magLeft=1; if(id==='pistol')sfx('pickup');}}
  if(P.swapT>0){P.swapT-=dt; P.fireCd=Math.max(P.fireCd,0); P.spin=Math.max(0,P.spin-dt*1.2); P.charge=0; updateBeam(dt,false); return;}
  if(g.mode==='beam'){updateBeam(dt,firing); return;}
  updateBeam(dt,false);
  if(g.mode==='charge'){
    const ok=P.midasT>0||P.ammo[P.slot]>=g.water;
    if(firing&&ok){P.charge=Math.min(1,P.charge+dt/g.chargeTime); if(Math.random()<0.5){const F=shotFrame(g.mz,0); burst(F.x,F.y,F.z,1,0x7dd3fc,1+P.charge*2,1,2,0.25);}}
    else if(P.charge>0){if(P.charge>0.12&&ok)fireTsunami(P.charge); P.charge=0;}
    else if(firing&&!ok&&!emptyWarned){toast('Out of water. Get back to the tank 💧'); emptyWarned=true;}
    return;
  }
  const hasAmmo=P.midasT>0||P.ammo[P.slot]>=Math.min(g.water,1)*0.999;
  if(g.mode==='spin')P.spin=(firing&&hasAmmo)?Math.min(1,P.spin+dt/g.spinTime):Math.max(0,P.spin-dt*1.2);
  P.fireCd-=dt;
  const blockedFire=g.mag&&P.reloadT>0;
  if(!firing||!hasAmmo||blockedFire){
    if(P.fireCd<0)P.fireCd=0;
    if(firing&&!hasAmmo&&!emptyWarned){toast('Out of water. Get back to the tank 💧'); emptyWarned=true;}
    return;
  }
  let rate=g.mode==='spin'?g.rateMin+(g.rateMax-g.rateMin)*P.spin:g.rate;
  if(P.rallyT>0)rate*=1.5;
  let n=0;
  while(P.fireCd<=0&&n<8){
    shootOnce(id); P.fireCd+=1/rate; n++;
    if(!(P.midasT>0||P.ammo[P.slot]>=Math.min(g.water,1)*0.999))break;
    if(g.mag&&P.reloadT>0)break;
  }
  if(g.mode==='auto'||g.mode==='spin'){sprayT-=dt; if(sprayT<=0){sfx('spray'); sprayT=0.07;}}
}
function swapGun(to){
  const P=player; if(!canAct())return;
  const target=to===undefined?1-P.slot:to;
  if(target===P.slot||!P.guns[target])return;
  if(P.beamOn){toast('The Guardian won\u2019t let go until its tank is empty.'); return;}
  P.slot=target; P.swapT=0.3; P.fireCd=0; P.spin=0; P.charge=0;
  buildGunModel(playerModel.gun,P.guns[target]); refreshViewmodel(); sfx('swing');
}


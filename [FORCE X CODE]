function spreadDir(ax,az,sp){const a=rand(-sp,sp); return [ax*Math.cos(a)-az*Math.sin(a), ax*Math.sin(a)+az*Math.cos(a)];}
function lookDir(){const cp=Math.cos(pitch); return {x:-Math.sin(yaw)*cp,y:Math.sin(pitch),z:-Math.cos(yaw)*cp};}
function rightVec(){return {x:Math.cos(yaw),z:-Math.sin(yaw)};}
function computeCross(){
  // point under the crosshair: nearest enemy body, ground, or far away
  const o=camera.position, f=lookDir(); let best=60;
  for(const e of enemies){
    if(e.dead)continue; const cy=e.g.position.y+e.h*0.5, rr=Math.max(e.r,e.h*0.5);
    const lx=e.x-o.x, ly=cy-o.y, lz=e.z-o.z, t=lx*f.x+ly*f.y+lz*f.z;
    if(t<0.5||t>best)continue;
    const px=o.x+f.x*t-e.x, py=o.y+f.y*t-cy, pz=o.z+f.z*t-e.z;
    if(px*px+py*py+pz*pz<rr*rr)best=t;
  }
  if(f.y<-0.001){const tg=-o.y/f.y; if(tg<best)best=tg;}
  cross.x=o.x+f.x*best; cross.y=o.y+f.y*best; cross.z=o.z+f.z*best;
  aimPt.set(cross.x,0,cross.z);
  if(f.y>=-0.001||best>=60){aimPt.set(o.x+f.x/Math.hypot(f.x,f.z)*22,0,o.z+f.z/Math.hypot(f.x,f.z)*22);}
}
function shotFrame(mz,side){

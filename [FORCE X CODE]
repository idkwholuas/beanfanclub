  $('tankFill').style.width=(tank.hp/tank.max*100)+'%';
  if(allies.length){
    const cnt={}; for(const a of allies)cnt[a.cls]=(cnt[a.cls]||0)+1;
    const sum=Object.keys(ALLY_CLASSES).filter(k=>cnt[k]).map(k=>`${ALLY_CLASSES[k].icon}×${cnt[k]}`).join(' ');
    const shown=allies.slice(-5);
    $('squad').innerHTML=`<div class="small" style="margin-top:6px"><span>Squad ${allies.length}</span><span>${sum}</span></div>`+shown.map(a=>`<div class="squad-m"><span>${ALLY_CLASSES[a.cls].icon} ${a.name}</span><div class="bar"><div class="fill hp" style="width:${a.hp/a.maxHp*100}%"></div></div></div>`).join('')+(allies.length>5?`<div class="small">+${allies.length-5} more</div>`:'');
  }else $('squad').innerHTML='<div class="small" style="margin-top:6px">Squad: just you. Rescue survivors!</div>';
  const parts=[]; if(vendettaShieldOn())parts.push('🛡️ Vendetta shield'); if(P.rallyT>0)parts.push('📣 Rally'); if(P.frenzyT>0)parts.push('🦈 Frenzy'); if(P.midasT>0)parts.push('💧 Endless');
  const bt=$('buffTxt'); if(parts.length){bt.classList.remove('hidden'); bt.textContent=parts.join(' · ');} else bt.classList.add('hidden');
  $('crateTxt').textContent=`📦 Crates this run: ${runCrates.length} · 🎥 ${VIEW_NAMES[viewMode]} (V)`;
  $('lockHint').classList.toggle('hidden',viewMode==='top'||pointerLocked||!usingMouse);
  const full=P.ammo.every((a,i)=>!P.guns[i]||a>=P.caps[i])&&P.hp>=P.maxHp&&P.balloons>=P.maxBalloons;
  $('hint').classList.toggle('hidden',!P.inZone||full);
  if(boss&&!boss.dead){$('bossWrap').classList.remove('hidden'); $('bossFill').style.width=Math.max(0,boss.hp/boss.maxHp*100)+'%';} else $('bossWrap').classList.add('hidden');
}
const projV=new THREE.Vector3();
function updateArrow(){
  const el=$('survArrow');
  if(!survivors.length||!canAct()){el.style.display='none';return;}
  let s=survivors[0],sd=1e9; for(const o of survivors){const d=Math.hypot(o.x-player.x,o.z-player.z); if(d<sd){sd=d;s=o;}}
  projV.set(s.x,1,s.z).project(camera);
  const behind=projV.z>1; let px=projV.x,py=projV.y; if(behind){px=-px;py=-py; if(Math.abs(py)<0.2)py=-0.2;}
  if(!behind&&Math.abs(px)<0.92&&Math.abs(py)<0.88){el.style.display='none';return;}
  const a=Math.atan2(py,px);
  el.style.display='block';
  el.style.left=`calc(50% + ${Math.cos(a)*40}vw - 15px)`; el.style.top=`calc(50% - ${Math.sin(a)*38}vh - 18px)`;
  el.style.transform=`rotate(${-a}rad)`;
}

/* ================= CAMERA / LOOP ================= */
const camPos=new THREE.Vector3(0,21,24);
function setFov(v){if(camera.fov!==v){camera.fov=v; camera.updateProjectionMatrix();}}
function updateCamera(dt){
  if(state==='menu'){
    vm.visible=false; vmMelee.visible=false; setFov(48);
    menuAng+=dt*0.12; camera.position.set(Math.sin(menuAng)*34,20,Math.cos(menuAng)*34); camera.lookAt(0,1,0);
    sun.position.set(20,40,15); sun.target.position.set(0,0,0); return;
  }
  const P=player;
  if(viewMode==='top'){
    vm.visible=false; vmMelee.visible=false; setFov(48);
    const k=camera.aspect<1?1.45:1, off=15*k;
    camPos.x+=(P.x-camPos.x)*Math.min(1,dt*6); camPos.z+=(P.z+off-camPos.z)*Math.min(1,dt*6); camPos.y=21*k;
    camera.position.copy(camPos);
    if(shake>0){camera.position.x+=rand(-1,1)*shake; camera.position.y+=rand(-1,1)*shake; shake=Math.max(0,shake-dt*2);}
    camera.lookAt(camPos.x,0,camPos.z-off);
  }else{
    setFov(viewMode==='fps'?75:70);
    const f=lookDir(), r=rightVec();
    if(P.moving&&state!=='paused')bobT+=dt*11;
    const bob=P.moving?Math.sin(bobT)*0.045:0;
    if(viewMode==='fps')camera.position.set(P.x,1.7+bob,P.z);
    else{const tx=P.x+r.x*0.85,tz=P.z+r.z*0.85,ty=2.0; camera.position.set(tx-f.x*4.6,Math.max(0.5,ty-f.y*4.6),tz-f.z*4.6);}
    if(shake>0){camera.position.x+=rand(-1,1)*shake*0.35; camera.position.y+=rand(-1,1)*shake*0.35; shake=Math.max(0,shake-dt*2);}
    camera.rotation.set(pitch,yaw,0);
    kick=Math.max(0,kick-dt*0.8);
    const show=viewMode==='fps'&&state!=='over';
    vm.visible=show&&!(P.swingT>0);
    vm.position.set(0.3+Math.cos(bobT*0.5)*0.012*(P.moving?1:0),-0.3+bob*0.4-(P.swapT>0?P.swapT*0.8:0),-0.6+kick);
    if(show&&P.swingT>0){const p=1-P.swingT/P.swingDur; vmMelee.visible=true; vmMelee.position.set(0.4-0.8*p,-0.35,-0.75); vmMelee.rotation.set(-1.2,0,1.1-2.2*p);}
    else vmMelee.visible=false;
  }
  sun.position.set(P.x+18,40,P.z+14); sun.target.position.set(P.x,0,P.z);
}
let last=performance.now();
function frame(now){
  const dt=Math.min(0.05,(now-last)/1000); last=now; const time=now/1000;
  if(canAct()){update(dt,time); hudT-=dt; if(hudT<=0){updateHUD(); hudT=0.05;} updateArrow();}
  if(state!=='paused'){updateFx(dt); updateRings(dt);}
  dropPool.sync(drops,WATER_COL); {const cool=[],hot=[]; for(const b of bigs)(b.fire?hot:cool).push(b); for(const o of orbs)cool.push(o); bigPool.sync(cool,[0.85,0.97,1]); firePool.sync(hot,[1,0.45,0.1]);} fxPool.sync(fx);
  updateCamera(dt);
  renderer.render(scene,camera);
}
function loop(now){requestAnimationFrame(loop); frame(now);}
requestAnimationFrame(loop);

/* ================= INPUT ================= */
const keys={};
window.addEventListener('keydown',e=>{
  keys[e.code]=true;
  if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.code)&&state!=='menu')e.preventDefault();
  if(e.repeat)return;
  if(e.code==='Space'||e.code==='KeyF')doMelee();
  if(e.code==='KeyQ')throwBalloon();
  if(e.code==='KeyE')useAbility();
  if(e.code==='Digit1')swapGun(0);
  if(e.code==='Digit2')swapGun(1);
  if(e.code==='ShiftLeft'||e.code==='ShiftRight')dash();
  if(e.code==='Escape'||e.code==='KeyP')togglePause();
  if(e.code==='KeyM'){muted=!muted; toast(muted?'Sound off':'Sound on');}
  if(e.code==='KeyV'&&canAct())setView(viewMode==='fps'?'tps':viewMode==='tps'?'top':'fps',true);
});
window.addEventListener('keyup',e=>{keys[e.code]=false;});
window.addEventListener('blur',()=>{for(const k in keys)keys[k]=false; mouseDown=false; if(canAct())togglePause();});
const cv=renderer.domElement;
const SENS=0.0024;
document.addEventListener('mousemove',e=>{
  if(viewMode==='top'||state!=='play'&&state!=='break')return;
  if(pointerLocked||usingMouse){yaw-=(e.movementX||0)*SENS; pitch-=(e.movementY||0)*SENS; pitch=Math.max(-1.25,Math.min(1.2,pitch));}
});
cv.addEventListener('pointermove',e=>{if(e.pointerType==='touch')return; if(!pointerLocked){mouse.x=e.clientX/window.innerWidth*2-1; mouse.y=-(e.clientY/window.innerHeight)*2+1;} if(!usingMouse){usingMouse=true; $('touch').classList.add('hidden');}});
cv.addEventListener('pointerdown',e=>{if(e.pointerType==='touch')return; if(!pointerLocked){mouse.x=e.clientX/window.innerWidth*2-1; mouse.y=-(e.clientY/window.innerHeight)*2+1;}
  if(viewMode!=='top'&&canAct()&&!pointerLocked)requestLock();
  if(e.button===0)mouseDown=true; if(e.button===2)throwBalloon();});
document.addEventListener('pointerlockchange',()=>{
  pointerLocked=document.pointerLockElement===renderer.domElement;
  if(!pointerLocked&&canAct()&&viewMode!=='top')togglePause();
});
window.addEventListener('pointerup',e=>{if(e.button===0)mouseDown=false;});
cv.addEventListener('contextmenu',e=>e.preventDefault());
let wheelT=0;
cv.addEventListener('wheel',e=>{const n=performance.now(); if(n-wheelT<200)return; wheelT=n; swapGun();},{passive:true});
window.addEventListener('resize',()=>{camera.aspect=window.innerWidth/window.innerHeight; camera.updateProjectionMatrix(); renderer.setSize(window.innerWidth,window.innerHeight);});

function setupStick(el,onMove,onEnd){
  let id=null,ox=0,oy=0; const knob=el.querySelector('.knob');
  const move=e=>{if(e.pointerId!==id)return; let dx=e.clientX-ox,dy=e.clientY-oy; const R=55,m=Math.hypot(dx,dy); if(m>R){dx=dx/m*R;dy=dy/m*R;} knob.style.transform=`translate(${dx}px,${dy}px)`; onMove(dx/R,dy/R);};
  el.addEventListener('pointerdown',e=>{id=e.pointerId; try{el.setPointerCapture(id);}catch(_){} const r=el.getBoundingClientRect(); ox=r.left+r.width/2; oy=r.top+r.height/2; move(e); e.preventDefault();});
  el.addEventListener('pointermove',move);
  const end=e=>{if(e.pointerId!==id)return; id=null; knob.style.transform=''; onEnd();};
  el.addEventListener('pointerup',end); el.addEventListener('pointercancel',end);
}
setupStick($('stickL'),(x,y)=>{touchMove.x=x;touchMove.y=y;},()=>{touchMove.x=0;touchMove.y=0;});
setupStick($('stickR'),(x,y)=>{usingMouse=false; const m=Math.hypot(x,y); touchAim.x=x;touchAim.y=y;touchAim.mag=m;touchAim.fire=m>0.3;},()=>{touchAim.fire=false;touchAim.mag=0;});
const tb=(id,fn)=>$(id).addEventListener('pointerdown',e=>{e.preventDefault(); fn();});
tb('tBal',()=>{usingMouse=false; throwBalloon();});
$('tFire').addEventListener('pointerdown',e=>{e.preventDefault(); usingMouse=false; touchFireBtn=true;});
['pointerup','pointercancel','pointerleave'].forEach(t=>$('tFire').addEventListener(t,()=>{touchFireBtn=false;})); tb('tMelee',doMelee); tb('tDash',dash); tb('tSwap',()=>swapGun()); tb('tAb',useAbility);
$('pauseBtn').addEventListener('click',togglePause);

/* ================= MENUS ================= */
let activeTab='play';
const bossesBeaten=()=>!!(save.bossKills.clog&&save.bossKills.king);
function itemRow(dotColor,name,tag,desc,actions,tier){
  const tierTag=tier?`<span class="tag" style="background:${TIER_COLOR[tier]};color:#fff">Class ${tier}</span>`:'';
  return `<div class="item"><div class="dot" style="background:${hex(dotColor)}"></div><div class="inf"><b>${name}</b>${tierTag}${tag?`<span class="tag">${tag}</span>`:''}<small>${desc}</small></div><div class="acts">${actions}</div></div>`;
}
function buyBtn(kind,id,cost,locked){
  if(locked)return `<button class="btn" disabled>${locked}</button>`;
  return `<button class="btn" data-buy="${kind}:${id}" ${save.coins<cost?'disabled':''}>🪙 ${cost}</button>`;
}
function renderArsenal(){
  const L=save.loadout, O=save.owned;
  let h='<div class="sec">Guns</div>';
  const order=['C','B','A','S','???'];
  for(const [id,g] of Object.entries(GUNS).sort((a,b)=>order.indexOf(a[1].tier)-order.indexOf(b[1].tier)||a[1].cost-b[1].cost)){
    let acts;
    if(O.guns.includes(id)){
      acts=g.solo?`<button class="btn ${L.g1===id?'on':''}" data-gun="${id}:1">${L.g1===id?'✓ Equipped':'Equip (both slots)'}</button>`
        :`<button class="btn ${L.g1===id?'on':''}" data-gun="${id}:1">${L.g1===id?'✓ ':''}Slot 1</button><button class="btn ${L.g2===id?'on':''}" data-gun="${id}:2">${L.g2===id?'✓ ':''}Slot 2</button>`;
    }else acts=buyBtn('guns',id,g.cost,g.needBosses&&!bossesBeaten()?'Beat both bosses':g.needWave&&save.best<g.needWave?`Reach wave ${g.needWave}`:'');
    h+=itemRow(g.color,g.name,WEIGHTS[g.weight].name,g.desc,acts,g.tier);
  }
  h+='<div class="sec">Balloons</div>';
  for(const [id,b] of Object.entries(BALLOONS)){
    const acts=O.balloons.includes(id)?`<button class="btn ${L.balloon===id?'on':''}" data-bal="${id}">${L.balloon===id?'✓ Equipped':'Equip'}</button>`:buyBtn('balloons',id,b.cost);
    h+=itemRow(b.color,b.name,'',b.desc,acts);
  }
  h+='<div class="sec">Melee</div>';
  const mcol={bat:0xa0703c,brush:0x3b82f6,plunger:0xdc2626,mop:0xcbd5e1,hammer:0x4b5563};
  for(const [id,w] of Object.entries(MELEE)){
    const acts=O.melee.includes(id)?`<button class="btn ${L.melee===id?'on':''}" data-mel="${id}">${L.melee===id?'✓ Equipped':'Equip'}</button>`:buyBtn('melee',id,w.cost);
    h+=itemRow(mcol[id],w.name,`${w.dmg} dmg`,w.desc,acts);
  }
  $('tab-arsenal').innerHTML=h;
}
function renderChars(){
  $('tab-chars').innerHTML='<div class="note" style="margin:0 0 10px">Every character has a passive trait and an active ability (E). Unlock them from crates; boss characters drop from bosses.</div>'+SKINS.map(s=>{
    const own=save.skins.includes(s.id), eq=save.equipped===s.id;
    const src=s.bossOnly?`Boss drop: ${POOP_TYPES[s.bossOnly].name}`:`${RARITY[s.rarity].name} crate`;
    return `<div class="item char ${own?'':'locked'} ${eq?'eq':''}"><div class="sw"><i style="background:${hex(s.body)}"></i><i style="background:${hex(s.accent)}"></i></div>
      <div class="inf"><b>${s.name}</b><span class="tag" style="color:${RARITY[s.rarity].color}">${src}</span><small>🧬 ${s.trait}</small><small>⭐ ${s.abName}: ${s.abDesc} (${s.cd}s cooldown)</small></div>
      <div class="acts">${own?`<button class="btn ${eq?'on':''}" data-skin="${s.id}">${eq?'✓ Playing':'Play as'}</button>`:'<button class="btn" disabled>Locked</button>'}</div></div>`;
  }).join('');
}
function renderMenu(){
  $('menuStats').innerHTML=`<span>🪙 ${save.coins} coins</span><span>🏆 Best wave ${save.best}</span><span>📦 ${totalCrates()} unopened</span>`;
  document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active',t.dataset.tab===activeTab));
  ['play','arsenal','chars','crates','armory'].forEach(t=>$('tab-'+t).classList.toggle('hidden',t!==activeTab));
  const L=save.loadout, C=charDef();
  $('loadoutSum').innerHTML=`<div>Character<b>${C.name}</b></div><div>Slot 1<b>${GUNS[L.g1].name}</b></div><div>Slot 2<b>${GUNS[L.g1].solo?'Taken by '+GUNS[L.g1].name:L.g2?GUNS[L.g2].name:'Empty'}</b></div><div>Balloon<b>${BALLOONS[L.balloon].name}</b></div><div>Melee<b>${MELEE[L.melee].name}</b></div>`;
  if(activeTab==='arsenal')renderArsenal();
  if(activeTab==='chars')renderChars();
  $('crateList').innerHTML=Object.keys(RARITY).map(r=>`<div class="crate-row" style="--rc:${RARITY[r].color}"><div class="crate-ic"></div><div class="crate-info"><b>${RARITY[r].name} crate</b><span>You have ${save.crates[r]}</span></div><button class="btn" data-open="${r}" ${save.crates[r]?'':'disabled'}>Open</button></div>`).join('')
    +(totalCrates()?'':'<div class="note">No crates yet. Clear waves and flush poopbies to earn them.</div>');
  $('armoryList').innerHTML=UPGRADES.map(u=>{const l=save.upg[u.id], max=l>=5, c=upCost(l);
    return `<div class="up-row"><div class="ic">${u.icon}</div><div class="inf"><b>${u.name}</b><small>${u.desc}</small><div class="pips">${[0,1,2,3,4].map(i=>`<i class="${i<l?'on':''}"></i>`).join('')}</div></div><button class="btn" data-up="${u.id}" ${max||save.coins<c?'disabled':''}>${max?'Maxed':'🪙 '+c}</button></div>`;}).join('');
}
document.querySelector('.tabs').addEventListener('click',e=>{const t=e.target.closest('.tab'); if(!t)return; activeTab=t.dataset.tab; $('crateResult').innerHTML=''; renderMenu();});
$('tab-arsenal').addEventListener('click',e=>{
  const b=e.target.closest('button'); if(!b||b.disabled)return; const L=save.loadout;
  if(b.dataset.buy){
    const [kind,id]=b.dataset.buy.split(':'), cost=(kind==='guns'?GUNS:kind==='balloons'?BALLOONS:MELEE)[id].cost;
    if(save.coins<cost)return; save.coins-=cost; save.owned[kind].push(id); sfx('crate');
    if(kind==='balloons')L.balloon=id; if(kind==='melee')L.melee=id; if(kind==='guns'&&!L.g2&&!GUNS[L.g1].solo&&!GUNS[id].solo)L.g2=id;
  }else if(b.dataset.gun){
    const [id,slot]=b.dataset.gun.split(':');
    if(GUNS[id].solo){if(L.g1!==id&&L.g2!==id){L.g1=id; L.g2=null; sfx('pickup');} persist(); renderMenu(); return;}
    if(GUNS[L.g1].solo&&slot==='2'){toast('The Hellrider takes up both slots. Equip another gun in Slot 1 to replace it.'); return;}
    if(slot==='1'){if(L.g1===id)return; if(L.g2===id)L.g2=L.g1; L.g1=id;}
    else{if(L.g2===id){L.g2=null;} else{if(L.g1===id){if(!L.g2){toast('Slot 1 needs a gun. Equip another gun there first.');return;} L.g1=L.g2;} L.g2=id;}}
    sfx('pickup');
  }else if(b.dataset.bal){L.balloon=b.dataset.bal; sfx('pickup');}
  else if(b.dataset.mel){L.melee=b.dataset.mel; sfx('pickup'); buildPlayerModel();}
  persist(); renderMenu();
});
$('tab-chars').addEventListener('click',e=>{const b=e.target.closest('[data-skin]'); if(!b||b.disabled)return; save.equipped=b.dataset.skin; persist(); buildPlayerModel(); sfx('pickup'); renderMenu();});
$('crateList').addEventListener('click',e=>{
  const b=e.target.closest('[data-open]'); if(!b)return; const r=b.dataset.open, res=openCrate(r); if(!res)return;
  sfx('crate');
  $('crateResult').innerHTML=`<div class="reveal" style="--rc:${RARITY[r].color}">${res.skin?`<div class="sw" style="justify-content:center;margin-bottom:6px"><i style="background:${hex(res.skin.body)}"></i><i style="background:${hex(res.skin.accent)}"></i></div>New character: ${res.skin.name}<br>`:''}+${res.coins} coins</div>`;
  renderMenu();
});
$('armoryList').addEventListener('click',e=>{const b=e.target.closest('[data-up]'); if(!b||b.disabled)return; const id=b.dataset.up, c=upCost(save.upg[id]); if(save.coins<c||save.upg[id]>=5)return; save.coins-=c; save.upg[id]++; persist(); sfx('pickup'); renderMenu();});
$('playBtn').addEventListener('click',startRun);
document.querySelectorAll('[data-view]').forEach(b=>b.addEventListener('click',()=>{setView(b.dataset.view,false); sfx('pickup');}));
applyViewUI();
$('againBtn').addEventListener('click',startRun);
$('menuBtn').addEventListener('click',goMenu);
$('resumeBtn').addEventListener('click',togglePause);
$('quitBtn').addEventListener('click',()=>{save.best=Math.max(save.best,wave-1>0?wave-1:0); persist(); goMenu();});
renderMenu();
})();
</script>

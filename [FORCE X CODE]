function buildWave(n){
  const q=[], isBoss=n%5===0;
  if(isBoss)q.push(Math.floor(n/5)%2===1?'clog':'king');
  const count=4+n*3-(isBoss?3:0);
  const pool=['walker','walker','walker']; if(n>=2)pool.push('runner','runner'); if(n>=3)pool.push('splatter','brick'); if(n>=4)pool.push('spitter','spitter'); if(n>=7)pool.push('brick','runner','splatter');
  for(let i=0;i<count;i++)q.push(pick(pool));
  return q;
}
function nextWave(){
  wave++; spawnQueue=buildWave(wave); spawnT=1.5; state='play';
  showBanner('Wave '+wave,wave%5===0?'⚠ Boss incoming':'Hold the tank. Find survivors.',2.2);

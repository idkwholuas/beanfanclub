<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Force X: Poopbie Apocalypse</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bungee&family=Rubik:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{
  --pool:#1e90d6; --water:#4cc9f0; --toy:#ff7a1a; --sewer:#6b4423; --hazard:#ffd23f; --danger:#ef4444; --ok:#22c55e;
  --panel:rgba(255,255,255,.9); --panel-solid:#ffffff; --text:#13293d; --muted:#4f6577; --line:rgba(19,41,61,.14); --chip:rgba(19,41,61,.06);
  --bg:#b7cbd3; --brown-text:#6b4423;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --panel:rgba(10,24,36,.88); --panel-solid:#0e2233; --text:#eaf6fb; --muted:#9db6c6; --line:rgba(255,255,255,.14); --chip:rgba(255,255,255,.07); --bg:#0e2233; --brown-text:#d2a374;
  }
}
:root[data-theme="dark"]{
  --panel:rgba(10,24,36,.88); --panel-solid:#0e2233; --text:#eaf6fb; --muted:#9db6c6; --line:rgba(255,255,255,.14); --chip:rgba(255,255,255,.07); --bg:#0e2233; --brown-text:#d2a374;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
html,body{margin:0;height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:Rubik,system-ui,-apple-system,"Segoe UI",sans-serif;touch-action:none;user-select:none;-webkit-user-select:none}
#game{position:fixed;inset:0}
#game canvas{display:block;width:100%;height:100%}
.hidden{display:none!important}
button{font-family:inherit;cursor:pointer}
button:focus-visible{outline:3px solid var(--water);outline-offset:2px}

#hud{position:fixed;inset:0;pointer-events:none}
.panel{background:var(--panel);border:2px solid var(--line);border-radius:14px;padding:10px 12px;backdrop-filter:blur(6px)}
.hud-tl{position:absolute;left:12px;top:calc(env(safe-area-inset-top,0px) + 12px);width:min(270px,44vw)}
.hud-tr{position:absolute;right:12px;top:calc(env(safe-area-inset-top,0px) + 12px);width:min(230px,40vw)}
.hud-tc{position:absolute;left:50%;transform:translateX(-50%);top:calc(env(safe-area-inset-top,0px) + 10px);text-align:center;width:min(420px,52vw)}
.row{display:flex;align-items:center;gap:8px;margin:3px 0}
.lbl{font-weight:800;font-size:12px;min-width:30px}
.bar{flex:1;height:12px;background:var(--chip);border-radius:7px;overflow:hidden;border:1px solid var(--line)}
.fill{height:100%;width:100%;border-radius:7px;transition:width .12s linear}
.fill.hp{background:linear-gradient(90deg,#16a34a,#4ade80)}
.fill.water{background:linear-gradient(90deg,var(--pool),var(--water))}
.fill.tank{background:linear-gradient(90deg,#64748b,#94a3b8)}
.fill.bossf{background:linear-gradient(90deg,#7c2d12,#b45309)}
.num{font-size:12px;font-weight:600;min-width:58px;text-align:right;font-variant-numeric:tabular-nums}
.small{font-size:12px;color:var(--muted);display:flex;justify-content:space-between;gap:6px}
.line{font-size:12.5px;font-weight:600;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.line.ab{color:var(--pool)}
.wave{font-family:Bungee,Impact,"Arial Black",sans-serif;font-size:clamp(20px,4vw,30px);color:#fff;-webkit-text-stroke:1.5px var(--sewer);text-shadow:0 3px 0 var(--pool)}
.sub{font-weight:800;color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.6);font-size:14px}
#bossWrap{margin-top:6px}
#bossName{font-family:Bungee,Impact,sans-serif;color:var(--hazard);text-shadow:0 2px 0 #000;font-size:14px;margin-bottom:3px}
.bar.boss{height:14px;background:rgba(0,0,0,.35)}
.squad-m{display:flex;align-items:center;gap:6px;font-size:12px;margin-top:5px}
.squad-m span{min-width:78px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.squad-m .bar{height:8px}
.buff{margin-top:7px;font-weight:800;font-size:12px;color:#fff;background:linear-gradient(90deg,#dc2626,#f97316);padding:5px 8px;border-radius:8px;text-align:center}
.hint{position:absolute;left:50%;bottom:calc(env(safe-area-inset-bottom,0px) + 24px);transform:translateX(-50%);background:var(--pool);color:#fff;font-weight:800;padding:8px 16px;border-radius:999px;font-size:14px;box-shadow:0 4px 0 #0b5f91}
#crosshair{position:absolute;left:50%;top:50%;width:0;height:0}
#crosshair i{position:absolute;background:#fff;box-shadow:0 0 2px #000,0 0 1px #000}
#crosshair i:nth-child(1){left:-12px;top:-1px;width:7px;height:2px}
#crosshair i:nth-child(2){left:5px;top:-1px;width:7px;height:2px}
#crosshair i:nth-child(3){top:-12px;left:-1px;width:2px;height:7px}
#crosshair i:nth-child(4){top:5px;left:-1px;width:2px;height:7px}
#crosshair b{position:absolute;left:-2px;top:-2px;width:4px;height:4px;border-radius:50%;background:var(--water);box-shadow:0 0 2px #000}
#crosshair.hit i{background:#ff4d4d}
#crosshair.hit{transform:scale(1.25)}
.viewsel{display:flex;align-items:center;gap:6px;margin-top:10px;flex-wrap:wrap}
.viewsel span{font-weight:800;font-size:13px;color:var(--muted);margin-right:4px}
.viewsel .btn{flex:1}
.viewsel .btn.on{background:var(--pool);color:#fff;box-shadow:0 3px 0 #0b5f91}
#survArrow{position:absolute;font-size:30px;color:#fef08a;text-shadow:0 0 8px #000;transform-origin:center;display:none}
.iconbtn{pointer-events:auto;position:absolute;right:12px;bottom:calc(env(safe-area-inset-bottom,0px) + 12px);width:44px;height:44px;border-radius:12px;border:2px solid var(--line);background:var(--panel);color:var(--text);font-weight:800}

#vignette{position:fixed;inset:0;pointer-events:none;box-shadow:inset 0 0 140px 40px rgba(239,68,68,.75);opacity:0;transition:opacity .25s}
#banner{position:fixed;left:0;right:0;top:32%;text-align:center;pointer-events:none;opacity:0;transform:scale(.85);transition:opacity .25s,transform .25s}
#banner.show{opacity:1;transform:scale(1)}
#bannerTitle{font-family:Bungee,Impact,"Arial Black",sans-serif;font-size:clamp(30px,7vw,64px);color:#fff;-webkit-text-stroke:2px var(--sewer);text-shadow:0 5px 0 var(--pool),0 10px 20px rgba(0,0,0,.35)}
#bannerSub{margin-top:6px;font-weight:800;color:#fff;text-shadow:0 2px 4px rgba(0,0,0,.7);font-size:clamp(14px,2.4vw,19px);padding:0 16px}
#toasts{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(env(safe-area-inset-bottom,0px) + 70px);display:flex;flex-direction:column;align-items:center;gap:6px;pointer-events:none;width:90vw}
.toast{background:var(--panel-solid);color:var(--text);border:2px solid var(--line);border-radius:10px;padding:7px 12px;font-weight:600;font-size:14px;animation:tin .25s ease-out;text-align:center}
@keyframes tin{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

#touch{position:fixed;inset:0;pointer-events:none}
.stick{position:absolute;bottom:calc(env(safe-area-inset-bottom,0px) + 28px);width:130px;height:130px;border-radius:50%;background:rgba(255,255,255,.18);border:3px solid rgba(255,255,255,.45);pointer-events:auto;touch-action:none}
#stickL{left:24px}
#stickR{right:24px}
.knob{position:absolute;left:50%;top:50%;width:56px;height:56px;margin:-28px 0 0 -28px;border-radius:50%;background:rgba(255,255,255,.75)}
#stickR .knob{background:rgba(76,201,240,.9)}
.tbtns{position:absolute;right:170px;bottom:calc(env(safe-area-inset-bottom,0px) + 24px);display:grid;grid-template-columns:repeat(2,52px);gap:8px;pointer-events:auto}
.tbtns button{width:52px;height:52px;border-radius:50%;border:3px solid rgba(255,255,255,.6);background:rgba(19,41,61,.45);font-size:22px;touch-action:none}

.overlay{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;padding:16px;background:linear-gradient(180deg,rgba(30,144,214,.25),rgba(107,68,35,.35));overflow-y:auto}
.card{background:var(--panel-solid);border:3px solid var(--line);border-radius:22px;width:min(640px,100%);padding:22px 22px 18px;box-shadow:0 10px 0 rgba(19,41,61,.18),0 24px 50px rgba(0,0,0,.25);max-height:100%;overflow-y:auto}
.title{font-family:Bungee,Impact,"Arial Black",sans-serif;font-size:clamp(46px,11vw,78px);line-height:.95;text-align:center;color:var(--water);-webkit-text-stroke:2.5px #0b4f7a;text-shadow:0 6px 0 #0b4f7a}
.subtitle{text-align:center;font-weight:800;font-size:clamp(14px,3.4vw,18px);color:var(--brown-text);margin-top:10px}
.stats{display:flex;justify-content:center;flex-wrap:wrap;gap:8px;margin:14px 0 12px}
.stats span{background:var(--chip);border-radius:999px;padding:5px 11px;font-weight:600;font-size:14px}
.tabs{display:flex;gap:4px;background:var(--chip);padding:5px;border-radius:14px;margin-bottom:14px;overflow-x:auto}
.tab{flex:1;border:0;background:transparent;color:var(--muted);font-weight:800;padding:9px 8px;border-radius:10px;font-size:13.5px;white-space:nowrap}
.tab.active{background:var(--pool);color:#fff}
.big{display:block;width:100%;border:0;border-radius:16px;padding:16px;font-family:Bungee,Impact,sans-serif;font-size:24px;color:#fff;background:var(--toy);box-shadow:0 6px 0 #b34f06;transition:transform .08s}
.big:active{transform:translateY(4px);box-shadow:0 2px 0 #b34f06}
.btn{border:0;border-radius:10px;padding:8px 12px;font-weight:800;background:var(--pool);color:#fff;box-shadow:0 3px 0 #0b5f91;font-size:13px;white-space:nowrap}
.btn:disabled{opacity:.4;cursor:default}
.btn.ghost{background:var(--chip);color:var(--text);box-shadow:none}
.btn.on{background:var(--ok);box-shadow:0 3px 0 #15803d}
.controls{margin-top:14px;font-size:14px;color:var(--muted);line-height:1.6}
.controls b{color:var(--text)}
.kv{display:grid;grid-template-columns:auto 1fr;gap:3px 12px}
.note{margin-top:14px;font-size:12.5px;color:var(--muted);text-align:center;line-height:1.45}
.loadout{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:6px;margin-top:12px}
.loadout div{background:var(--chip);border-radius:10px;padding:7px 9px;font-size:12.5px;color:var(--muted)}
.loadout b{display:block;color:var(--text);font-size:13.5px}
.sec{font-family:Bungee,Impact,sans-serif;font-size:17px;margin:16px 0 8px;color:var(--pool)}
.sec:first-child{margin-top:2px}
.item{display:flex;align-items:center;gap:10px;padding:10px;border-radius:12px;background:var(--chip);margin-bottom:7px}
.item .inf{flex:1;min-width:0}
.item .inf b{font-size:14.5px}
.item .inf small{display:block;color:var(--muted);font-size:12.5px;line-height:1.35;margin-top:2px}
.item .acts{display:flex;flex-direction:column;gap:5px}
.tag{display:inline-block;font-size:11px;font-weight:800;padding:2px 7px;border-radius:999px;margin-left:6px;vertical-align:2px;background:var(--line)}
.dot{width:30px;height:30px;border-radius:50%;flex:none;border:3px solid rgba(0,0,0,.18)}
.crate-row{display:flex;align-items:center;gap:12px;padding:9px;border-radius:12px;background:var(--chip);margin-bottom:8px}
.crate-ic{width:40px;height:40px;border-radius:8px;background:var(--rc);box-shadow:inset 0 -6px 0 rgba(0,0,0,.25),inset 0 0 0 3px rgba(0,0,0,.25)}
.crate-info{flex:1;display:flex;flex-direction:column}
.crate-info span{color:var(--muted);font-size:13px}
.reveal{margin-top:10px;padding:14px;border-radius:14px;border:3px solid var(--rc);text-align:center;font-weight:800;animation:pop .35s ease-out}
@keyframes pop{0%{transform:scale(.6);opacity:0}70%{transform:scale(1.06)}100%{transform:scale(1);opacity:1}}
.sw{display:flex;gap:4px;flex:none}
.sw i{width:20px;height:20px;border-radius:50%;border:2px solid rgba(0,0,0,.2)}
.char.locked{opacity:.55}
.char.eq{outline:3px solid var(--pool)}
.up-row{display:flex;align-items:center;gap:12px;padding:10px;border-radius:12px;background:var(--chip);margin-bottom:8px}
.up-row .ic{font-size:26px}
.up-row .inf{flex:1}
.up-row .inf small{display:block;color:var(--muted)}
.pips{display:flex;gap:3px;margin-top:4px}
.pips i{width:14px;height:6px;border-radius:3px;background:var(--line)}
.pips i.on{background:var(--toy)}
.over-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0}
.over-stats div{background:var(--chip);border-radius:12px;padding:10px;text-align:center}
.over-stats b{display:block;font-family:Bungee,Impact,sans-serif;font-size:24px}
.btnrow{display:flex;gap:8px;margin-top:10px}
.btnrow .btn{flex:1;padding:12px}
@media (prefers-reduced-motion: reduce){.reveal,.toast{animation:none}#banner{transition:none}}
</style>
</head>
<body>
<div id="game"></div>
<div id="vignette"></div>

<div id="hud" class="hidden">
  <div class="hud-tl panel">
    <div class="row"><span class="lbl">HP</span><div class="bar"><div id="hpFill" class="fill hp"></div></div><span id="hpTxt" class="num"></span></div>
    <div class="row"><span class="lbl">H₂O</span><div class="bar"><div id="waterFill" class="fill water"></div></div><span id="waterTxt" class="num"></span></div>
    <div id="gunTxt" class="line"></div>
    <div id="balTxt" class="line"></div>
    <div id="abTxt" class="line ab"></div>
    <div class="small"><span id="weightTxt"></span><span id="dashTxt"></span></div>
  </div>
  <div class="hud-tc">
    <div id="waveTxt" class="wave">Wave 1</div>
    <div id="enemyTxt" class="sub"></div>
    <div id="bossWrap" class="hidden"><div id="bossName"></div><div class="bar boss"><div id="bossFill" class="fill bossf"></div></div></div>
  </div>
  <div class="hud-tr panel">
    <div class="row"><span class="lbl">Tank</span><div class="bar"><div id="tankFill" class="fill tank"></div></div></div>
    <div id="squad"></div>
    <div id="buffTxt" class="buff hidden"></div>
    <div id="crateTxt" class="small" style="margin-top:6px"></div>
  </div>
  <div id="hint" class="hint hidden">Refilling at the tank 💧</div>
  <div id="survArrow">➤</div>
  <div id="crosshair" class="hidden"><i></i><i></i><i></i><i></i><b></b></div>
  <div id="lockHint" class="hint hidden" style="bottom:auto;top:58%">Click to aim with your mouse · V switches camera</div>
  <button id="pauseBtn" class="iconbtn" aria-label="Pause">❚❚</button>
</div>

<div id="banner"><div id="bannerTitle"></div><div id="bannerSub"></div></div>
<div id="toasts"></div>

<div id="touch" class="hidden">
  <div id="stickL" class="stick"><div class="knob"></div></div>
  <div id="stickR" class="stick"><div class="knob"></div></div>
  <div class="tbtns">
    <button id="tAb" aria-label="Use ability">⭐</button>
    <button id="tSwap" aria-label="Swap gun">🔄</button>
    <button id="tBal" aria-label="Throw balloon">🎈</button>
    <button id="tMelee" aria-label="Melee">🏏</button>
    <button id="tDash" aria-label="Dash">💨</button>
    <button id="tFire" aria-label="Fire" class="hidden">💦</button>
  </div>
</div>

<div id="menu" class="overlay">
  <div class="card">
    <div class="title">FORCE X</div>
    <div class="subtitle">💩 The Poopbie Apocalypse 💦</div>
    <div id="menuStats" class="stats"></div>
    <div class="tabs" role="tablist">
      <button class="tab active" data-tab="play">Deploy</button>
      <button class="tab" data-tab="arsenal">Arsenal</button>
      <button class="tab" data-tab="chars">Characters</button>
      <button class="tab" data-tab="crates">Crates</button>
      <button class="tab" data-tab="armory">Armory</button>
    </div>
    <div id="tab-play" class="tabpane">
      <button id="playBtn" class="big">Deploy 💦</button>
      <div class="viewsel"><span>Camera</span><button class="btn ghost" data-view="fps">First person</button><button class="btn ghost" data-view="tps">Third person</button><button class="btn ghost" data-view="top">Top-down</button></div>
      <div id="loadoutSum" class="loadout"></div>
      <div class="controls">
        <div class="kv">
          <b>Move</b><span>WASD / arrows</span>
          <b>Look</b><span>Mouse (click the game to lock it)</span>
          <b>Shoot</b><span>Hold left mouse</span>
          <b>Camera</b><span>V cycles first person, third person, top-down</span>
          <b>Swap gun</b><span>1 / 2 or scroll wheel</span>
          <b>Balloon</b><span>Right click or Q</span>
          <b>Melee</b><span>Space or F</span>
          <b>Ability</b><span>E</span>
          <b>Dash</b><span>Shift</span>
          <b>Refill</b><span>Stand in the blue ring by the tank</span>
          <b>Pause</b><span>P or Esc · M mutes</span>
        </div>
        <p style="margin:10px 0 0">Heavier guns slow you down. Protect the tank and flush every wave for crates you keep forever. Each wave has 0 to 4 survivors under colored beacons: 🎯 blue Shooters, 🥊 red Meleists, 💉 pink Assistants and 🔧 orange Mechanics. Your squad has no size limit, but survivors are fragile.</p>
      </div>
    </div>
    <div id="tab-arsenal" class="tabpane hidden"></div>
    <div id="tab-chars" class="tabpane hidden"></div>
    <div id="tab-crates" class="tabpane hidden"><div id="crateList"></div><div id="crateResult"></div></div>
    <div id="tab-armory" class="tabpane hidden"><div id="armoryList"></div></div>
    <div class="note">Single-player prototype. Online co-op and free-for-all need a game server, so they're the next build step.</div>
  </div>
</div>

<div id="pause" class="overlay hidden">
  <div class="card" style="width:min(360px,100%);text-align:center">
    <div class="title" style="font-size:44px">Paused</div>
    <div class="btnrow" style="margin-top:18px"><button id="resumeBtn" class="btn">Resume</button><button id="quitBtn" class="btn ghost">Quit to menu</button></div>
  </div>
</div>

<div id="over" class="overlay hidden">
  <div class="card" style="width:min(440px,100%)">
    <div class="title" style="font-size:clamp(36px,9vw,52px)">Flushed out</div>
    <div id="overReason" class="subtitle"></div>
    <div id="overStats" class="over-stats"></div>
    <div id="overCrates" class="note" style="margin-top:0"></div>
    <div class="btnrow"><button id="againBtn" class="btn">Deploy again</button><button id="menuBtn" class="btn ghost">Main menu</button></div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){
'use strict';
const $=id=>document.getElementById(id);
const rand=(a,b)=>a+Math.random()*(b-a);
const pick=a=>a[Math.floor(Math.random()*a.length)];
const TAU=Math.PI*2;
const hex=n=>'#'+n.toString(16).padStart(6,'0');

/* ================= GAME DATA ================= */
const RARITY={
  common:{name:'Common',color:'#9aa4ad',hex:0x9aa4ad,coins:2},
  rare:{name:'Rare',color:'#3d8bff',hex:0x3d8bff,coins:5},
  epic:{name:'Epic',color:'#a855f7',hex:0xa855f7,coins:12},
  legendary:{name:'Legendary',color:'#f5b301',hex:0xf5b301,coins:30}
};
const WEIGHTS={
  ultra:{name:'Ultra light',spd:1.25},
  xlight:{name:'Extremely light',spd:1.15},
  light:{name:'Light',spd:1.05},
  medium:{name:'Medium',spd:0.95},
  heavy:{name:'Heavy',spd:0.8},
  extreme:{name:'Extremely heavy',spd:0.62}
};
const GUNS={
  rifle:{name:'Rifle',weight:'medium',cost:0,cap:120,mode:'auto',rate:40,dmg:1.7,spread:0.04,speed:36,life:0.7,water:0.45,mz:0.75,color:0xff7a1a,
    desc:'Fast-firing and accurate. Easy to use.'},
  shotgun:{name:'Splash Shotgun',weight:'medium',cost:250,cap:100,mode:'burst',rate:1.7,pellets:9,dmg:4,spread:0.32,speed:28,life:0.42,water:6,kb:1.6,mz:0.9,color:0x22c55e,
    desc:'Huge close-range burst that knocks poopbies back.'},
  washer:{name:'Pressure Washer',weight:'medium',cost:300,cap:120,mode:'auto',rate:50,dmg:1.6,spread:0.05,speed:24,life:0.33,water:0.4,ap:true,mz:1.05,color:0xfacc15,
    desc:'Short range, very high damage. Ignores brick armor.'},
  bubble:{name:'Bubble Blaster',weight:'light',cost:300,cap:80,mode:'bubble',rate:3,dmg:8,speed:13,water:4,mz:0.5,color:0xf472b6,
    desc:'Slow bubbles that trap poopbies for 2s (bosses 0.6s).'},

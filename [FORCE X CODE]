    ox=camera.position.x+f.x*0.7+r.x*sd; oy=camera.position.y-0.2+f.y*0.7; oz=camera.position.z+f.z*0.7+r.z*sd;}
  else{const m=muzzle(P,mz,side); ox=m.x; oy=1.35; oz=m.z;}
  let dx=cross.x-ox,dy=cross.y-oy,dz=cross.z-oz; const l=Math.hypot(dx,dy,dz)||1;
  return {x:ox,y:oy,z:oz,dx:dx/l,dy:dy/l,dz:dz/l,top:false};
}
function jitter(F,sp){

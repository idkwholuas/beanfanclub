function collideMove(actor,delta){
  const r=actor.radius, pos=actor.pos;
  // Vertical body span differs by actor: player's pos.y is eye height (feet = pos.y-height),
  // bots' pos.y is feet (group origin). Normalize to an absolute feet/head range.
  const feetY = actor.isPlayer ? (pos.y - actor.height) : pos.y;
  const headY = feetY + actor.height;
  ['x','z'].forEach(axis=>{
    pos[axis]+=delta[axis];
    const pmin=new THREE.Vector3(pos.x-r, feetY, pos.z-r), pmax=new THREE.Vector3(pos.x+r, headY, pos.z+r);
    for(const c of State.colliders){
      if(pmax.x>c.min.x&&pmin.x<c.max.x&&pmax.y>c.min.y&&pmin.y<c.max.y&&pmax.z>c.min.z&&pmin.z<c.max.z){ pos[axis]-=delta[axis]; break; }
    }
  });
  const B=State.bounds-1; pos.x=Math.max(-B,Math.min(B,pos.x)); pos.z=Math.max(-B,Math.min(B,pos.z));
}
function groundHeight(actor){
  let top=0; const r=actor.radius;
  for(const c of State.colliders){
    if(actor.pos.x+r>c.min.x&&actor.pos.x-r<c.max.x&&actor.pos.z+r>c.min.z&&actor.pos.z-r<c.max.z){
      if(c.max.y>top&&c.max.y<actor.pos.y+1.2) top=Math.max(top,c.max.y);
    }
  }
  return top;
}

// screen-right (what the player sees as right) = cross(forward, up) = (-cos yaw, 0, sin yaw)
function fwdVec(){ return new THREE.Vector3(Math.sin(Input.yaw),0,Math.cos(Input.yaw)); }
function rightVec(){ return new THREE.Vector3(-Math.cos(Input.yaw),0,Math.sin(Input.yaw)); }

function updatePlayer(dt){
  const p=State.player; if(!p.alive) return;
  const fwd=fwdVec(), right=rightVec();
  let move=new THREE.Vector3();
  if(Input.keys['KeyW']) move.add(fwd);
  if(Input.keys['KeyS']) move.sub(fwd);
  if(Input.keys['KeyD']) move.add(right);   // D = right
  if(Input.keys['KeyA']) move.sub(right);   // A = left
  if(move.lengthSq()>0) move.normalize();

  const sprint=(Input.keys['ShiftLeft']||Input.keys['ShiftRight'])?1.4:1;
  const speed=7.4*OP.speed*sprint;
  if(p.dashImpulse && State.time<p.dashEnd){ p.vel.x=p.dashDir.x*24; p.vel.z=p.dashDir.z*24; }
  else { p.dashImpulse=false; p.vel.x=move.x*speed; p.vel.z=move.z*speed; }

  if(Input.keys['Space']&&p.onGround){ p.vel.y=8.4; p.onGround=false; }
  p.vel.y-=22*dt;
  collideMove(p,new THREE.Vector3(p.vel.x*dt,0,p.vel.z*dt));
  p.pos.y+=p.vel.y*dt;
  const fy=1.7+groundHeight(p);
  if(p.pos.y<=fy){ p.pos.y=fy; p.vel.y=0; p.onGround=true; } else p.onGround=false;

  if(State.time-p.lastDamage>3){ p.shield=Math.min(p.maxShield,p.shield+18*dt); p.hp=Math.min(p.maxHp,p.hp+7*dt); }
  if(p.reloading && State.time>=p.reloadTimer) finishReload(p);
  if(p.burstLeft>0 && State.time>=p.burstTimer) doFire(p,true);

  // Recoil shake: a transient offset on top of real aim that ALWAYS springs back to 0,
  // so the screen vibrates on fire but settles right back down (aim never drifts).
  updateRecoil(dt);
  State.camera.position.copy(p.pos);
  const aimYaw = Input.yaw + Input.recoilYaw;
  const aimPitch = Math.max(-1.5, Math.min(1.5, Input.pitch + Input.recoilPitch));
  const dir=new THREE.Vector3(Math.sin(aimYaw)*Math.cos(aimPitch),Math.sin(aimPitch),Math.cos(aimYaw)*Math.cos(aimPitch));
  State.camera.lookAt(p.pos.clone().add(dir));

  if(Input.shooting) doFire(p,false);
}

function updateRecoil(dt){
  // critically-damped-ish spring back to zero, plus high-frequency vibration while kicking
  const stiff=140, damp=22;
  Input.recoilVelP += (-stiff*Input.recoilPitch - damp*Input.recoilVelP)*dt;
  Input.recoilVelY += (-stiff*Input.recoilYaw   - damp*Input.recoilVelY)*dt;
  Input.recoilPitch += Input.recoilVelP*dt;
  Input.recoilYaw   += Input.recoilVelY*dt;
  // snap tiny residuals to exactly zero so it always fully settles
  if(Math.abs(Input.recoilPitch)<0.0004 && Math.abs(Input.recoilVelP)<0.002){ Input.recoilPitch=0; Input.recoilVelP=0; }
  if(Math.abs(Input.recoilYaw)<0.0004 && Math.abs(Input.recoilVelY)<0.002){ Input.recoilYaw=0; Input.recoilVelY=0; }
}

function tryDash(){
  const p=State.player; if(!p.alive||State.time<p.dashCdEnd) return;
  p.dashCdEnd=State.time+OP.dashCd;
  const fwd=fwdVec(), right=rightVec(); const move=new THREE.Vector3();
  if(Input.keys['KeyW'])move.add(fwd); if(Input.keys['KeyS'])move.sub(fwd);
  if(Input.keys['KeyD'])move.add(right); if(Input.keys['KeyA'])move.sub(right);
  if(move.lengthSq()===0) move.copy(fwd);
  move.normalize();
  p.dashImpulse=true; p.dashDir=move; p.dashEnd=State.time+0.22;
}

function melee(){
  const p=State.player; if(!p.alive||State.time<p.meleeCdEnd) return;
  p.meleeCdEnd=State.time+MELEE.cd;
  meleeSwingFx();
  const fwd=fwdVec().normalize(); const eye=p.pos.clone();
  let hit=false;
  State.bots.filter(b=>b.alive&&b.team==='enemy').forEach(b=>{
    const to=b.pos.clone().sub(eye); to.y=0; const dist=to.length();
    if(dist>MELEE.range||dist<0.01) return; to.normalize();
    if(to.dot(fwd)<(1-MELEE.arc)) return;
    const wd=worldRayDist(eye.clone().add(new THREE.Vector3(0,1.2,0)),to);
    if(wd<dist-0.6) return;
    dealDamage(p,b,MELEE.damage,b.pos.clone().add(new THREE.Vector3(0,1.2,0)));
    if(b.alive){ const kb=to.clone().multiplyScalar(1.4); collideMove(b,new THREE.Vector3(kb.x,0,kb.z)); b.group.position.copy(b.pos); }
    hit=true;
  });
  if(hit) showHitMarker();
}

/* ----------------------------- FIRING ----------------------------- */
function doFire(actor,fromBurst){
  const w=curWeapon(actor);
  if(actor.reloading) return;
  const now=performance.now();
  if(!fromBurst && now-actor.lastFire<w.fireRate) return;
  if(w.inMag<=0){ actor.isPlayer?reload():startReload(actor); return; }
  if(actor.isPlayer && !w.auto && !w.burst && Input.semiLatch) return;

  if(w.burst && !fromBurst) actor.burstLeft=w.burst;
  actor.lastFire=now;
  if(actor.isPlayer && !w.auto && !w.burst) Input.semiLatch=true;

  w.inMag--;
  if(actor.isPlayer){ State.shots++; updateWeaponHUD(); muzzlePlayer(); recoil(w); }
  else muzzleBot(actor);

  const origin=fireOrigin(actor);
  const dir=fireDir(actor,w.spread);
  if(w.explosive){ spawnProjectile(actor,origin,dir,w); }
  else { for(let i=0;i<w.pellets;i++){ hitscan(actor,origin,i===0?dir:fireDir(actor,w.spread),w); } }

  if(w.burst){ actor.burstLeft--; if(actor.burstLeft>0) actor.burstTimer=State.time+0.06; }
  if(w.inMag<=0){ actor.isPlayer?reload():startReload(actor); }
}

function fireOrigin(actor){ return actor.isPlayer?State.camera.position.clone():actor.pos.clone().add(new THREE.Vector3(0,1.6,0)); }
function fireDir(actor,spread){
  let d;
  if(actor.isPlayer){
    // Fire along the EXACT direction the camera is looking (recoil included),
    // so bullets always go where the centre crosshair points on screen.
    const ay=Input.yaw+Input.recoilYaw;
    const ap=Math.max(-1.5,Math.min(1.5,Input.pitch+Input.recoilPitch));
    d=new THREE.Vector3(Math.sin(ay)*Math.cos(ap),Math.sin(ap),Math.cos(ay)*Math.cos(ap));
  } else {
    const t=actor.target;
    if(!t) d=new THREE.Vector3(0,0,1);
    else { d=new THREE.Vector3(t.pos.x-actor.pos.x,(t.pos.y+0.6)-(actor.pos.y+1.6),t.pos.z-actor.pos.z).normalize();
           const miss=(1-actor.aim)*0.10; d.x+=(Math.random()-0.5)*miss; d.y+=(Math.random()-0.5)*miss; d.z+=(Math.random()-0.5)*miss; }
  }
  if(spread>0){ d.x+=(Math.random()-0.5)*spread*2; d.y+=(Math.random()-0.5)*spread*2; d.z+=(Math.random()-0.5)*spread*2; }
  return d.normalize();
}

function hitscan(shooter,origin,dir,w){
  State.raycaster.set(origin,dir); State.raycaster.far=220;
  const worldDist=worldRayDist(origin,dir);

  if(w.pierce){
    // hit every enemy along the ray, up to the first wall
    const list=[];
    targetsFor(shooter).forEach(t=>{
      // distance of t's center projected onto the ray + perpendicular check
      const center=t.pos.clone().add(new THREE.Vector3(0,1.0,0));
      const oc=center.clone().sub(origin);
      const along=oc.dot(dir);
      if(along<0||along>worldDist) return;
      const perp=oc.clone().sub(dir.clone().multiplyScalar(along)).length();
      if(perp<1.2){ list.push({t,along,point:origin.clone().add(dir.clone().multiplyScalar(along))}); }
    });
    list.sort((a,b)=>a.along-b.along);
    let any=false;
    list.forEach(h=>{ dealDamage(shooter,h.t,w.damage,h.point); any=true; });
    if(shooter.isPlayer){ tracer(origin,origin.clone().add(dir.clone().multiplyScalar(Math.min(worldDist,120)))); if(any){ State.hits++; showHitMarker(); } }
    return;
  }

  const meshes=[];
  targetsFor(shooter).forEach(t=>{ if(t.group){ t.group.traverse(o=>{ if(o.isMesh){ o.userData.actor=t; meshes.push(o); } }); } });
  let bestDist=1e9, hitActor=null, head=false, point=null;
  const hits=State.raycaster.intersectObjects(meshes,true);
  if(hits.length){ const h=hits[0]; bestDist=h.distance; hitActor=h.object.userData.actor; head=h.point.y>hitActor.pos.y+1.5; point=h.point.clone(); }
  // player-as-target manual sphere test (bots shooting the player)
  targetsFor(shooter).forEach(t=>{
    if(!t.isPlayer) return;
    const center=t.pos.clone().add(new THREE.Vector3(0,-0.5,0));
    const oc=origin.clone().sub(center); const b=oc.dot(dir); const c2=oc.dot(oc)-1.1*1.1;
    const disc=b*b-c2; if(disc>0){ const dist=-b-Math.sqrt(disc); if(dist>0&&dist<bestDist){ bestDist=dist; hitActor=t; head=false; point=origin.clone().add(dir.clone().multiplyScalar(dist)); } }
  });
  if(worldDist<bestDist){ if(shooter.isPlayer) tracer(origin,origin.clone().add(dir.clone().multiplyScalar(worldDist))); return; }
  const end=point?point:origin.clone().add(dir.clone().multiplyScalar(120));
  if(shooter.isPlayer) tracer(origin,end);
  if(hitActor){ dealDamage(shooter,hitActor,w.damage*(head?w.headMult:1),point); if(shooter.isPlayer){ State.hits++; showHitMarker(); } }
}

function worldRayDist(origin,dir){ let best=1e9; for(const c of State.colliders){ const t=rayBox(origin,dir,c.min,c.max); if(t!=null&&t<best) best=t; } return best; }
function rayBox(o,d,min,max){
  let tmin=-1e9,tmax=1e9;
  for(const ax of ['x','y','z']){
    if(Math.abs(d[ax])<1e-8){ if(o[ax]<min[ax]||o[ax]>max[ax]) return null; }
    else { let t1=(min[ax]-o[ax])/d[ax],t2=(max[ax]-o[ax])/d[ax]; if(t1>t2){const tmp=t1;t1=t2;t2=tmp;} tmin=Math.max(tmin,t1); tmax=Math.min(tmax,t2); }
  }
  if(tmax>=Math.max(tmin,0)) return tmin>0?tmin:0; return null;
}

/* ----------------------------- EXPLOSIVES ----------------------------- */
function spawnProjectile(shooter,origin,dir,w){
  const mesh=new THREE.Mesh(new THREE.SphereGeometry(0.22,10,10),new THREE.MeshBasicMaterial({color:0xffc14d}));
  mesh.position.copy(origin).add(dir.clone().multiplyScalar(1.2));
  mesh.add(new THREE.PointLight(0xffaa33,2,6));
  State.scene.add(mesh);
  State.projectiles.push({mesh,shooter,vel:dir.clone().multiplyScalar(w.speed),arc:!!w.arc,bounce:false,
    damage:w.damage,splash:w.splash,radius:w.radius,life:5,fuse:false});
}
function throwGrenade(){
  const p=State.player; if(!p.alive||p.grenades<=0) return;
  p.grenades--; document.getElementById('nadeTxt').textContent=p.grenades;
  const dir=new THREE.Vector3(Math.sin(Input.yaw)*Math.cos(Input.pitch),Math.sin(Input.pitch)+0.35,Math.cos(Input.yaw)*Math.cos(Input.pitch)).normalize();
  const origin=State.camera.position.clone().add(dir.clone().multiplyScalar(1.0));
  const mesh=new THREE.Mesh(new THREE.IcosahedronGeometry(0.24,0),new THREE.MeshLambertMaterial({color:0x88dd44,emissive:0x224400}));
  mesh.position.copy(origin); State.scene.add(mesh);
  State.projectiles.push({mesh,shooter:p,vel:dir.multiplyScalar(26),arc:true,bounce:true,damage:55,splash:50,radius:6,life:1.6,fuse:true});
}
function botGrenade(b,t){
  const from=b.pos.clone().add(new THREE.Vector3(0,1.6,0));
  const dir=t.pos.clone().sub(from); dir.y=0; const flat=dir.length(); dir.normalize();
  const v=dir.multiplyScalar(20); v.y=8+flat*0.15;
  const mesh=new THREE.Mesh(new THREE.IcosahedronGeometry(0.24,0),new THREE.MeshLambertMaterial({color:0xff8844,emissive:0x441100}));
  mesh.position.copy(from); State.scene.add(mesh);
  State.projectiles.push({mesh,shooter:b,vel:v,arc:true,bounce:true,damage:45,splash:42,radius:5.5,life:1.6,fuse:true});
}
function updateProjectiles(dt){
  for(let i=State.projectiles.length-1;i>=0;i--){
    const pr=State.projectiles[i];
    if(pr.arc) pr.vel.y-=20*dt;
    const next=pr.mesh.position.clone().add(pr.vel.clone().multiplyScalar(dt));
    pr.mesh.rotation.x+=dt*8; pr.mesh.rotation.y+=dt*6; pr.life-=dt;
    let hit=false;
    if(next.y<=0.3){ if(pr.bounce){ next.y=0.3; pr.vel.y*=-0.45; pr.vel.x*=0.6; pr.vel.z*=0.6; } else hit=true; }
    for(const c of State.colliders){
      if(next.x>c.min.x&&next.x<c.max.x&&next.y>c.min.y&&next.y<c.max.y&&next.z>c.min.z&&next.z<c.max.z){ if(pr.bounce) pr.vel.multiplyScalar(-0.4); else hit=true; break; }
    }
    if(!pr.bounce){
      for(const t of targetsFor(pr.shooter)){ if(next.distanceTo(t.pos.clone().add(new THREE.Vector3(0,1,0)))<1.2){ hit=true; break; } }
    }
    pr.mesh.position.copy(next);
    if((pr.fuse&&pr.life<=0)||hit||pr.life<=0){
      explode(pr.shooter,pr.mesh.position.clone(),pr.damage,pr.splash,pr.radius);
      State.scene.remove(pr.mesh); State.projectiles.splice(i,1);
    }
  }
}
function explode(shooter,pos,direct,splash,radius){
  explosionFx(pos,radius);
  [State.player,...State.bots].filter(a=>a.alive).forEach(a=>{
    const d=a.pos.clone().add(new THREE.Vector3(0,1,0)).distanceTo(pos);
    if(d<radius){
      let dmg=splash*(1-d/radius)+(d<1.5?direct:0);
      if(a.team===shooter.team&&a!==shooter) dmg*=0.5;
      if(a===shooter) dmg*=0.4;
      dealDamage(shooter,a,dmg,a.pos.clone().add(new THREE.Vector3(0,1,0)));
    }
  });
}

/* ----------------------------- BOT AI ----------------------------- */
function updateBots(dt){
  State.bots.forEach(b=>{
    if(!b.alive) return;
    const foes=(b.team==='ally')
      ? State.bots.filter(x=>x.team==='enemy'&&x.alive)
      : [State.player,...State.bots.filter(x=>x.team==='ally'&&x.alive)].filter(a=>a.alive);
    b.target = foes.length ? foes.reduce((a,c)=> a.pos.distanceTo(b.pos)<c.pos.distanceTo(b.pos)?a:c ) : null;
    const t=b.target;
    if(t){
      const to=new THREE.Vector3(t.pos.x-b.pos.x,0,t.pos.z-b.pos.z); const dist=to.length(); to.normalize();
      b.group.rotation.y=Math.atan2(to.x,to.z);
      const w=b.weapon;
      const ideal = w.id==='shotgun'?7 : (w.id==='sniper'||w.id==='dmr')?22 : 14;
      b.strafeTimer-=dt; if(b.strafeTimer<=0){ b.strafeDir=Math.random()<0.5?-1:1; b.strafeTimer=0.6+Math.random()*1.2; }
      const strafe=new THREE.Vector3(-to.z,0,to.x).multiplyScalar(b.strafeDir);
      let md=new THREE.Vector3();
      if(dist>ideal+2) md.add(to); else if(dist<ideal-3) md.sub(to);
      md.add(strafe.multiplyScalar(0.7)); if(md.lengthSq()>0) md.normalize();
      const spd=6.6*OP.speed;
      collideMove(b,new THREE.Vector3(md.x*spd*dt,0,md.z*spd*dt));
      b.vel.y-=22*dt; b.pos.y+=b.vel.y*dt; const fy=groundHeight(b); if(b.pos.y<=fy){ b.pos.y=fy; b.vel.y=0; }

      const eye=b.pos.clone().add(new THREE.Vector3(0,1.6,0));
      const aimv=t.pos.clone().add(new THREE.Vector3(0,0.6,0)).sub(eye); const losDist=aimv.length(); aimv.normalize();
      const hasLOS=worldRayDist(eye,aimv)>losDist-0.5;

      if(b.reloading && State.time>=b.reloadTimer) finishReload(b);
      if(b.burstLeft>0 && State.time>=b.burstTimer) doFire(b,true);
      b.fireCd-=dt;
      if(hasLOS && dist<60 && b.fireCd<=0 && !b.reloading){
        if(w.inMag<=0) startReload(b);
        else { doFire(b,false); b.fireCd = w.auto? (w.fireRate/1000)*(2+Math.random()*3) : (w.fireRate/1000)+Math.random()*0.25; }
      }
      b.grenadeCd-=dt;
      if(b.grenadeCd<=0 && dist<26 && dist>6 && hasLOS && Math.random()<0.5){ b.grenadeCd=7+Math.random()*6; botGrenade(b,t); }
    }
    if(State.time-b.lastDamage>3.5){ b.shield=Math.min(b.maxShield,b.shield+14*dt); b.hp=Math.min(b.maxHp,b.hp+5*dt); }
    if(b.hitFlash>0){ b.hitFlash-=dt*4; b.body.material.emissiveIntensity=0.25+Math.max(0,b.hitFlash); }
    b.group.position.copy(b.pos);
  });
}

/* ----------------------------- DAMAGE / RELOAD ----------------------------- */
function dealDamage(shooter,target,dmg,point){
  if(!target.alive) return;
  // Every hit lands for at least 1, no matter how small the raw amount.
  dmg = Math.max(1, dmg);
  target.lastDamage=State.time;
  const dealt = Math.max(1, Math.round(dmg));   // what we show — the real total this hit
  // apply to shield first, then health (the FULL amount, so 1+ always registers)
  if(target.shield>0){ const s=Math.min(target.shield,dmg); target.shield-=s; dmg-=s; }
  if(dmg>0) target.hp-=dmg;
  if(!target.isPlayer){ target.hitFlash=1; if(point) damageNumber(point,dealt); }
  else {
    const f=document.getElementById('dmgFlash'); f.style.opacity='1'; setTimeout(()=>f.style.opacity='0',90);
    document.getElementById('lowhp').style.opacity= target.hp<35?'1':'0'; updateVitals();
  }
  if(target.hp<=0){ target.hp=0; killActor(shooter,target,point); }
}
function killActor(shooter,target,point){
  target.alive=false;
  if(!target.isPlayer){ deathBurst(target.pos.clone(),target.body.material.color); State.scene.remove(target.group); }
  const sName=shooter.isPlayer?'YOU':(shooter.team==='ally'?'ALLY':'HOSTILE');
  const tName=target.isPlayer?'YOU':(target.team==='ally'?'ALLY':'HOSTILE');
  killFeed(sName,tName);
  if(shooter.isPlayer && target.team==='enemy'){ State.kills++; State.score+=100; }
  updateRoster(); updateScoreHUD(); checkRoundEnd();
}
function reload(){ const p=State.player,w=curWeapon(p);
  if(p.reloading||w.inMag>=w.mag||w.reserve<=0) return;
  p.reloading=true; p.reloadTimer=State.time+w.reload/1000; document.getElementById('reloadPip').classList.add('on'); }
function startReload(a){ const w=curWeapon(a); if(a.reloading||w.reserve<=0||w.inMag>=w.mag) return; a.reloading=true; a.reloadTimer=State.time+w.reload/1000; }
function finishReload(a){ const w=curWeapon(a); const take=Math.min(w.mag-w.inMag,w.reserve); w.inMag+=take; w.reserve-=take; a.reloading=false;
  if(a.isPlayer){ document.getElementById('reloadPip').classList.remove('on'); updateWeaponHUD(); } }

/* ----------------------------- EFFECTS ----------------------------- */
function muzzlePlayer(){ const d=fwdVec(); flashAt(State.camera.position.clone().add(d.multiplyScalar(1.2)).add(new THREE.Vector3(0,-0.2,0))); }
function muzzleBot(b){ flashAt(b.pos.clone().add(new THREE.Vector3(0,1.5,0))); }
function flashAt(pos){ const f=new THREE.PointLight(0xffd27a,3,8); f.position.copy(pos); State.scene.add(f); setTimeout(()=>State.scene.remove(f),45); }
function tracer(a,b){
  const g=new THREE.BufferGeometry().setFromPoints([a.clone().add(new THREE.Vector3(0,-0.12,0)),b]);
  const line=new THREE.Line(g,new THREE.LineBasicMaterial({color:0xfff0a0,transparent:true,opacity:0.85}));
  State.scene.add(line); const t0=State.time;
  State.effects.push({tick:(now)=>{ line.material.opacity=0.85-(now-t0)*9; if(now-t0>0.09){ State.scene.remove(line); return false; } return true; }});
}
function explosionFx(pos,radius){
  const ring=new THREE.Mesh(new THREE.TorusGeometry(0.6,0.3,8,28),new THREE.MeshBasicMaterial({color:0xffc14d,transparent:true}));
  ring.rotation.x=Math.PI/2; ring.position.copy(pos); State.scene.add(ring);
  const ball=new THREE.Mesh(new THREE.SphereGeometry(0.8,12,12),new THREE.MeshBasicMaterial({color:0xff7733,transparent:true}));
  ball.position.copy(pos); State.scene.add(ball);
  const light=new THREE.PointLight(0xff8833,6,radius*4); light.position.copy(pos); State.scene.add(light);
  const t0=State.time;
  State.effects.push({tick:(now)=>{ const k=now-t0; ring.scale.setScalar(1+k*radius*4); ring.material.opacity=Math.max(0,1-k*1.6);
    ball.scale.setScalar(1+k*radius*1.5); ball.material.opacity=Math.max(0,0.9-k*2.4); light.intensity=Math.max(0,6-k*18);
    if(k>0.7){ State.scene.remove(ring); State.scene.remove(ball); State.scene.remove(light); return false; } return true; }});
  for(let i=0;i<10;i++){ const p=new THREE.Mesh(new THREE.BoxGeometry(0.18,0.18,0.18),new THREE.MeshBasicMaterial({color:0xffaa44}));
    p.position.copy(pos); const v=new THREE.Vector3((Math.random()-0.5)*12,Math.random()*9,(Math.random()-0.5)*12); const tt=State.time;
    State.scene.add(p); State.effects.push({tick:(now,dt)=>{ v.y-=20*dt; p.position.addScaledVector(v,dt); if(now-tt>0.7){ State.scene.remove(p); return false; } return true; }}); }
}
function deathBurst(pos,color){
  for(let i=0;i<16;i++){ const p=new THREE.Mesh(new THREE.BoxGeometry(0.15,0.15,0.15),new THREE.MeshBasicMaterial({color}));
    p.position.copy(pos); p.position.y+=1; const v=new THREE.Vector3((Math.random()-0.5)*9,Math.random()*8,(Math.random()-0.5)*9); const t0=State.time;
    State.scene.add(p); State.effects.push({tick:(now,dt)=>{ v.y-=18*dt; p.position.addScaledVector(v,dt); if(now-t0>0.8){ State.scene.remove(p); return false; } return true; }}); }
}
function meleeSwingFx(){
  let el=document.getElementById('meleeFx');
  if(!el){ el=document.createElement('div'); el.id='meleeFx';
    el.style.cssText='position:fixed;inset:0;z-index:24;pointer-events:none;overflow:hidden';
    el.innerHTML='<div style="position:absolute;top:42%;left:18%;width:64%;height:5px;background:linear-gradient(90deg,transparent,#fff,transparent);transform:rotate(-22deg);opacity:0;border-radius:3px;box-shadow:0 0 18px #c7f23a,0 0 40px rgba(199,242,58,.5)"></div>';
    document.body.appendChild(el); }
  const blade=el.firstChild; if(!blade||!blade.style) return;
  blade.style.transition='none'; blade.style.opacity='0.95'; blade.style.transform='rotate(-46deg) translateX(-30px)';
  requestAnimationFrame(()=>{ blade.style.transition='transform .18s ease-out,opacity .22s ease-out'; blade.style.transform='rotate(8deg) translateX(40px)'; blade.style.opacity='0'; });
}
function damageNumber(point,val){
  const div=document.createElement('div'); div.textContent=val;
  div.style.cssText="position:fixed;z-index:25;font-family:'Chakra Petch';font-weight:700;font-size:16px;color:#fff;pointer-events:none;text-shadow:0 2px 6px #000;transition:all .6s ease-out;";
  document.body.appendChild(div);
  const v=point.clone().project(State.camera); if(v.z>1){ div.remove(); return; }
  const x=(v.x*0.5+0.5)*innerWidth,y=(-v.y*0.5+0.5)*innerHeight; div.style.left=x+'px'; div.style.top=y+'px';
  requestAnimationFrame(()=>{ div.style.top=(y-46)+'px'; div.style.opacity='0'; }); setTimeout(()=>div.remove(),600);
}
function recoil(w){
  // Per-shot impulse into the recoil spring (which always returns to center).
  // Values are angular-velocity impulses (rad/s); the spring damps them back to 0.
  const kick = w.id==='launcher'||w.id==='railgun'||w.id==='sniper' ? 5.5
             : w.id==='shotgun'||w.id==='autoshotgun'||w.id==='flak' ? 4.5
             : w.id==='minigun'||w.id==='lmg' ? 2.0
             : 2.6;
  Input.recoilVelP += kick;                                   // punch the view up
  Input.recoilVelY += (Math.random()-0.5)*kick*0.9;           // random L/R vibration
}
function showHitMarker(){ const hm=document.getElementById('hitMarker'); hm.style.transition='none'; hm.style.opacity='1'; requestAnimationFrame(()=>{ hm.style.transition='opacity .3s'; hm.style.opacity='0'; }); }

/* ----------------------------- HUD ----------------------------- */
function updateVitals(){ const p=State.player;
  document.getElementById('hpBar').style.transform=`scaleX(${Math.max(0,p.hp/p.maxHp)})`;
  document.getElementById('shBar').style.transform=`scaleX(${Math.max(0,p.shield/p.maxShield)})`;
  document.getElementById('hpTxt').textContent=Math.ceil(p.hp); document.getElementById('shTxt').textContent=Math.ceil(p.shield); }
function updateWeaponHUD(){ const w=curWeapon(State.player);
  document.getElementById('magTxt').textContent=w.inMag; document.getElementById('resTxt').textContent=w.reserve;
  document.getElementById('wnameTxt').textContent=w.name; document.getElementById('nadeTxt').textContent=State.player.grenades; }
function updateScoreHUD(){ document.getElementById('hudAlly').textContent=alliesAlive(); document.getElementById('hudEnemy').textContent=enemiesAlive(); }
function killFeed(a,b){
  const kf=document.getElementById('killFeed'); const div=document.createElement('div'); div.className='kf';
  const ac=(a==='YOU'||a==='ALLY')?'a':'e', bc=(b==='YOU'||b==='ALLY')?'a':'e';
  div.innerHTML=`<span class="${ac}">${a}</span> <span class="x">✕</span> <span class="${bc}">${b}</span>`;
  kf.prepend(div); while(kf.children.length>5) kf.removeChild(kf.lastChild); setTimeout(()=>div.remove(),4500);
}
function updateRoster(){
  const r=document.getElementById('roster'); if(!r) return; r.innerHTML='';
  if(State.modeDef.wave) return;
  const mk=(team,label)=>{
    const wrap=document.createElement('div'); wrap.className='team '+team;
    const lab=document.createElement('div'); lab.className='tlabel'; lab.textContent=label; wrap.appendChild(lab);
    const members=[]; if(team==='ally'){ members.push(State.player); State.bots.filter(b=>b.team==='ally').forEach(b=>members.push(b)); }
    else State.bots.filter(b=>b.team==='enemy').forEach(b=>members.push(b));
    members.forEach(mm=>{ const d=document.createElement('div'); d.className='dot '+team+(mm.alive?'':' dead');
      const hpf=mm.alive?Math.max(0,mm.hp/mm.maxHp):0; d.innerHTML=`<i style="transform:scaleX(${hpf})"></i>`; wrap.appendChild(d); });
    return wrap;
  };
  r.appendChild(mk('ally','TEAM')); r.appendChild(mk('enemy','ENEMY'));
}

/* ----------------------------- ROUNDS / LIFECYCLE ----------------------------- */
function spawnRound(){
  State.bots.forEach(b=>{ if(b.group) State.scene.remove(b.group); }); State.bots=[];
  State.projectiles.forEach(p=>State.scene.remove(p.mesh)); State.projectiles=[];
  const md=State.modeDef, sp=State.spawnPoints;
  const ps=sp[0]; State.player.pos.set(ps[0],1.7,ps[ps.length-1]);
  State.player.alive=true; State.player.hp=OP.hp; State.player.shield=OP.shield; State.player.grenades=OP.grenades;
  State.player.weapons=sel.guns.map(newWeapon); State.player.curGun=0; State.player.reloading=false; State.player.burstLeft=0;
  Input.yaw=Math.atan2(-ps[0],-ps[ps.length-1]); Input.pitch=0;
  let idx=1;
  for(let i=0;i<md.allies;i++){ const s=sp[(++idx)%sp.length]; State.bots.push(makeBot('ally',s[0],s[s.length-1],0.8)); }
  const diff = md.vs==='1v1'?0.82 : md.wave?0.7 : 0.78;
  for(let i=0;i<md.enemies;i++){ const s=sp[(++idx)%sp.length]; State.bots.push(makeBot('enemy',s[0],s[s.length-1],diff)); }
  State.roundActive=true; State.time=0; State.waveTimer=0;
  updateVitals(); updateWeaponHUD(); updateScoreHUD(); updateRoster();
  document.getElementById('lowhp').style.opacity='0';
}
function checkRoundEnd(){
  if(!State.roundActive) return;
  if(State.modeDef.wave){ if(!State.player.alive) endMatch(false,'You fell. The waves never stopped.'); return; }
  if(enemiesAlive()===0){ State.roundsWonAlly++; endRound(true); }
  else if(alliesAlive()===0){ State.roundsWonEnemy++; endRound(false); }
}
function endRound(won){
  State.roundActive=false;
  const need=Math.ceil(State.modeDef.rounds/2);
  banner(won?'ROUND WON':'ROUND LOST', won?'#c7f23a':'#ff4d57', `${State.roundsWonAlly} — ${State.roundsWonEnemy}`);
  if(State.roundsWonAlly>=need){ setTimeout(()=>endMatch(true,'Series won — enemy team eliminated.'),1400); return; }
  if(State.roundsWonEnemy>=need){ setTimeout(()=>endMatch(false,'Series lost. Redeploy and adapt.'),1400); return; }
  State.round++;
  setTimeout(()=>{ if(State.running) spawnRound(); },1600);
}
function banner(title,color,sub){
  let el=document.getElementById('roundBanner');
  if(!el){ el=document.createElement('div'); el.id='roundBanner';
    el.style.cssText="position:fixed;inset:0;z-index:30;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;font-family:'Chakra Petch'";
    document.body.appendChild(el); }
  el.innerHTML=`<div style="font-size:54px;font-weight:700;letter-spacing:.12em;color:${color};text-shadow:0 6px 30px #000">${title}</div><div style="font-size:30px;color:#e6edf3;letter-spacing:.2em;margin-top:6px">${sub}</div>`;
  el.style.opacity='1'; el.style.transition='none';
  requestAnimationFrame(()=>{ el.style.transition='opacity .6s'; setTimeout(()=>{ el.style.opacity='0'; },900); });
}

function startMatch(){
  document.getElementById('menu').classList.add('hidden');
  State.modeDef=MODES[sel.mode]; State.mapDef=MAPS[sel.map];
  State.bounds= sel.map==='dunes'?56:50;
  document.getElementById('hudMode').textContent=State.modeDef.label;
  // build synchronously inside the Deploy click so the browser grants pointer lock
  setupScene();
  State.player=makePlayer(); State.bots=[]; State.projectiles=[]; State.effects=[];
  State.kills=0;State.shots=0;State.hits=0;State.score=0;
  State.round=1;State.roundsWonAlly=0;State.roundsWonEnemy=0;
  State.clock=new THREE.Clock(); State.running=true; State.paused=false;
  spawnRound();
  document.getElementById('hud').classList.add('show'); canvas.classList.add('playing');
  Input.shooting=false;
  loop();
}
function loop(){
  if(!State.running) return;
  requestAnimationFrame(loop);
  if(State.paused) return;
  const dt=Math.min(State.clock.getDelta(),0.05); State.time+=dt;
  if(State.roundActive){
    updateLookFallback(dt); updatePlayer(dt); updateBots(dt); updateProjectiles(dt);
    if(State.modeDef.wave){
      State.waveTimer-=dt; const maxAlive=3+Math.floor(State.time/25);
      if(State.waveTimer<=0 && enemiesAlive()<Math.min(maxAlive,6)){
        const s=State.spawnPoints[Math.floor(Math.random()*State.spawnPoints.length)];
        State.bots.push(makeBot('enemy',s[0],s[s.length-1],0.7+Math.min(0.2,State.time/600)));
        State.waveTimer=3; updateScoreHUD();
      }
    }
    const remain=Math.max(0,State.modeDef.time-State.time);
    const mm=Math.floor(remain/60),ss=Math.floor(remain%60);
    document.getElementById('hudTime').textContent=`${mm}:${ss<10?'0':''}${ss}`;
    if(remain<=0){
      if(State.modeDef.wave) endMatch(true,'You survived the full assault.');
      else if(alliesAlive()>enemiesAlive()){ State.roundsWonAlly++; endRound(true); }
      else { State.roundsWonEnemy++; endRound(false); }
    }
    updateRoster();
  }
  for(let i=State.effects.length-1;i>=0;i--){ if(!State.effects[i].tick(State.time,dt)) State.effects.splice(i,1); }
  State.renderer.render(State.scene,State.camera);
}
function togglePause(on){
  if(!State.running) return;
  State.paused=on;
  document.getElementById('pause').classList.toggle('hidden',!on);
  if(on){
    Input.shooting=false;
    canvas.classList.remove('playing');
    if(document.pointerLockElement) document.exitPointerLock();
  } else {
    canvas.classList.add('playing');
    lockPointer();
  }
}
function quitToMenu(){
  State.running=false;
  document.getElementById('pause').classList.add('hidden');
  document.getElementById('hud').classList.remove('show'); canvas.classList.remove('playing');
  document.getElementById('menu').classList.remove('hidden'); teardown();
}
function endMatch(won,sub){
  if(!State.running) return; State.running=false; State.roundActive=false;
  document.getElementById('hud').classList.remove('show'); canvas.classList.remove('playing');
  const title=document.getElementById('resTitle');
  title.textContent=won?'VICTORY':'DEFEAT'; title.className=won?'win':'lose';
  document.getElementById('resSub').textContent=sub||'';
  document.getElementById('rsKills').textContent=State.kills;
  document.getElementById('rsScore').textContent=State.score;
  document.getElementById('rsAcc').textContent=(State.shots?Math.round(State.hits/State.shots*100):0)+'%';
  document.getElementById('rsRounds').textContent=State.roundsWonAlly;
  document.getElementById('results').classList.remove('hidden'); setTimeout(teardown,400);
}
function teardown(){
  if(State.scene){ State.scene.traverse(o=>{ if(o.geometry)o.geometry.dispose(); if(o.material){ Array.isArray(o.material)?o.material.forEach(m=>m.dispose()):o.material.dispose(); } }); }
  State.bots=[]; State.projectiles=[]; State.effects=[]; State.colliders=[];
}

</script>

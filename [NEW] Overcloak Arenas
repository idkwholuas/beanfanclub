function box(w,h,d,color,x,y,z,opts={}){
  const geo=new THREE.BoxGeometry(w,h,d);
  const mat=new THREE.MeshLambertMaterial({color,transparent:!!opts.transparent,opacity:opts.opacity??1});
  if(opts.emissive){ mat.emissive=new THREE.Color(opts.emissive); mat.emissiveIntensity=opts.ei??1; }
  const m=new THREE.Mesh(geo,mat); m.position.set(x,y,z); m.castShadow=true; m.receiveShadow=true;
  State.scene.add(m);
  if(!opts.noCollide){
    State.colliders.push({min:new THREE.Vector3(x-w/2,y-h/2,z-d/2),max:new THREE.Vector3(x+w/2,y+h/2,z+d/2)});
  }
  return m;
}

const canvas = document.getElementById('game');

/* SHIFT-LOCK style look — the mouse ALWAYS steers the view, no button held.
   - Preferred: pointer lock (cursor captured, true free-look).
   - Fallback (iframe / lock blocked): the cursor's POSITION over the screen
     steers the view continuously — move toward an edge to keep turning that way,
     centre = hold still. Works everywhere, still no button needed.
   Arrow keys also turn the view. */
function lockPointer(){ if(canvas.requestPointerLock) canvas.requestPointerLock(); }
document.addEventListener('pointerlockchange',()=>{ Input.locked = document.pointerLockElement===canvas; });
document.addEventListener('pointerlockerror',()=>{ Input.locked=false; });

canvas.addEventListener('mousedown',e=>{
  if(!State.running||State.paused) return;
  if(!Input.locked) lockPointer();        // try to capture; harmless if blocked
  if(e.button===0) Input.shooting=true;
});
addEventListener('mouseup',e=>{ if(e.button===0){ Input.shooting=false; Input.semiLatch=false; } });
canvas.addEventListener('contextmenu',e=>e.preventDefault());

addEventListener('mousemove',e=>{
  if(!State.running||State.paused) return;
  if(Input.locked){
    // captured: raw deltas move the view directly
    Input.yaw   -= e.movementX*Input.sens;
    Input.pitch -= e.movementY*Input.sens;
    Input.pitch  = Math.max(-1.4, Math.min(1.4, Input.pitch));
  } else {
    // not captured: remember cursor position; per-frame steering in updateLookFallback()
    Input.mx=e.clientX; Input.my=e.clientY; Input.haveMouse=true;
  }
});

// Per-frame look for the un-captured (shift-lock) case + arrow keys.
function updateLookFallback(dt){
  // arrow keys always work
  const k=Input.keys, kr=2.2*dt;
  if(k['ArrowLeft'])  Input.yaw   += kr;
  if(k['ArrowRight']) Input.yaw   -= kr;
  if(k['ArrowUp'])    Input.pitch += kr;
  if(k['ArrowDown'])  Input.pitch -= kr;
  // position-based steering when the pointer isn't captured
  if(!Input.locked && Input.haveMouse){
    const cx=innerWidth/2, cy=innerHeight/2;
    const nx=(Input.mx-cx)/cx, ny=(Input.my-cy)/cy;   // -1..1 from centre
    const dead=0.05, turn=3.0*dt;
    if(Math.abs(nx)>dead) Input.yaw   -= (nx-Math.sign(nx)*dead)*turn;
    if(Math.abs(ny)>dead) Input.pitch -= (ny-Math.sign(ny)*dead)*turn;
  }
  Input.pitch=Math.max(-1.4,Math.min(1.4,Input.pitch));
}


